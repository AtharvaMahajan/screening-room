# Copy to .env and fill in your own values. Never commit .env.
#
# One file configures both Docker Compose (POSTGRES_*) and the backend
# (DATABASE_URL). If you change a POSTGRES_* value, update DATABASE_URL to match.

# --- Docker Compose: local PostgreSQL -----------------------------------------
POSTGRES_USER=screening_room
POSTGRES_PASSWORD=change-me
POSTGRES_DB=screening_room
POSTGRES_PORT=5432

# --- Backend --------------------------------------------------------------------
# SQLAlchemy URL using the psycopg 3 driver. Use 127.0.0.1 rather than localhost:
# Compose publishes the port on 127.0.0.1 only, and "localhost" may resolve to
# IPv6 ::1 first, which adds a failed connection attempt (slow on Windows).
DATABASE_URL=postgresql+psycopg://screening_room:change-me@127.0.0.1:5432/screening_room

# HMAC key for CSRF tokens, at least 32 characters. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CSRF_SECRET=replace-with-output-of-the-command-above

# Origins allowed to make POST/PUT/PATCH/DELETE requests (a JSON list).
# Locally that's the Vite dev server.
ALLOWED_ORIGINS=["http://localhost:5173"]

# Local development runs over plain http, where browsers drop Secure cookies and
# reject __Host- cookie names. Production leaves both at their default (true).
COOKIE_SECURE=false
COOKIE_PREFIX_HOST=false

# Log lines: "text" for people (local), "json" for log tools (production).
LOG_FORMAT=text

# TMDB "API Read Access Token" (the long value starting with eyJ, not the
# short API key): themoviedb.org -> Settings -> API. Keep it in .env only.
TMDB_API_TOKEN=replace-with-your-tmdb-read-access-token
